{
  "name": "Pocket Chat",
  "short_name": "Chat",
  "description": "Private chat for your household and friends on your own server, linked to your Pocket apps and Pocket AI.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#128c7e",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Catch up",
      "url": "/"
    },
    {
      "name": "Saved",
      "url": "/saved"
    },
    {
      "name": "Search",
      "url": "/search"
    }
  ]
